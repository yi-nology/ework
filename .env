CUSTOM_DOMAIN=ework.murphyyi.com

VITE_ENABLE_RB=true
VITE_DATA_MODE=local
VITE_CONFIG_TYPE=rainbow-bridge
VITE_LOCAL_DATA_URL=/nav-data.json

VITE_RB_BASE_URL=http://localhost:8080/rainbow-bridge
VITE_RB_ENVIRONMENT=navi
VITE_RB_PIPELINE=main

VITE_NACOS_SERVER_ADDR=http://localhost:8848/nacos
VITE_NACOS_NAMESPACE=public
VITE_NACOS_DATA_ID=ework-nav.json
VITE_NACOS_GROUP=DEFAULT_GROUP

VITE_APOLLO_META=http://localhost:8080
VITE_APOLLO_APP_ID=ework-nav
VITE_APOLLO_NAMESPACE=application

VITE_SKIP_SSL_VERIFY=false
